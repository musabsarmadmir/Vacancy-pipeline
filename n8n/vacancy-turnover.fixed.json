      "id": "find-vacant",
      "name": "Find vacant units",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "// Computes stage and days-in-stage from the unit timestamps, then builds ONE digest message.\n// Keep SLA in sync with the dashboard. Add showing_at / application_at here if you track them.\nconst SLA = { 'Move-out': 30, 'Listed': 30 }; // days allowed per stage\nconst now = Date.now();\nconst money = v => '$' + Math.round(Number(v) || 0).toLocaleString('en-CA');\n\nconst rows = $input.all().map(i => i.json).filter(r => r && r.move_out_at);\n\nconst stuck = rows\n  .map(r => {\n    const stage = r.listed_at ? 'Listed' : 'Move-out';\n    const entered = new Date(r.listed_at || r.move_out_at).getTime();\n    const days = Math.floor((now - entered) / 86400000);\n    return { ...r, stage, days, sla: SLA[stage], over: days - SLA[stage] };\n  })\n  .filter(r => r.over > 0)\n  .sort((a, b) => b.over - a.over);\n\nif (stuck.length === 0) return []; // nothing past SLA, stop here\n\nconst rentAtRisk = stuck.reduce((s, r) => s + (Number(r.rent) || 0), 0);\nlet text = `Vacancy SLA alert: ${stuck.length} units past SLA` +\n  (rentAtRisk ? `, ${money(rentAtRisk)}/month rent at risk` : '') + '\\n';\nfor (const r of stuck.slice(0, 15)) {\n  text += `- ${r.property_name} ${r.unit_number}: ${r.stage}, ${r.days}d (SLA ${r.sla}d)\\n`;\n}\nif (stuck.length > 15) text += `...and ${stuck.length - 15} more. Open the vacancy pipeline.\\n`;\n\nreturn [{ json: { text } }];\n"
      },
      "id": "find-stuck",
      "name": "Find units past SLA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        500
      ]
    },
