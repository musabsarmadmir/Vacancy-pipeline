    {
      "parameters": {
        "jsCode": "// Turns a notice into a dated turnover checklist.\nconst n = $('Webhook').first().json.body || {};\nfor (const k of ['unit_id', 'move_out_date']) {\n  if (!n[k]) throw new Error(`Missing field: ${k}`);\n}\nconst moveOut = new Date(n.move_out_date + 'T00:00:00Z');\nif (isNaN(moveOut)) throw new Error('move_out_date must be YYYY-MM-DD');\n\nconst today = new Date();\ntoday.setUTCHours(0, 0, 0, 0);\nconst iso = d => d.toISOString().slice(0, 10);\nconst addDays = (d, k) => { const x = new Date(d); x.setUTCDate(x.getUTCDate() + k); return x; };\n\n// offset = days relative to the move-out date. Edit to match KO Realty's real process.\nconst template = [\n  { offset: -14, role: 'Leasing',     title: 'Publish \"available from\" listing using existing photos' },\n  { offset: -7,  role: 'Maintenance', title: 'Pre-move-out inspection, list repairs needed' },\n  { offset: -5,  role: 'Maintenance', title: 'Book cleaners, painters and trades' },\n  { offset: 0,   role: 'Operations',  title: 'Collect keys, move-out inspection, photo walk-through' },\n  { offset: 1,   role: 'Maintenance', title: 'Start repairs and paint' },\n  { offset: 3,   role: 'Cleaning',    title: 'Deep clean' },\n  { offset: 4,   role: 'Leasing',     title: 'Professional photos, refresh listing' },\n  { offset: 5,   role: 'Leasing',     title: 'Unit move-in ready, open showings' },\n];\n\nconst tasks = template.map(t => {\n  let due = addDays(moveOut, t.offset);\n  if (due < today) due = today; // short notice: nothing can be due in the past\n  return { unit_id: n.unit_id, title: t.title, role: t.role, due_date: iso(due), status: 'open' };\n});\n\nreturn [{ json: { unit: n, tasks } }];\n"
      },
      "id": "83481c9b-cbbd-4fca-b6c3-48eed156c4c1",
