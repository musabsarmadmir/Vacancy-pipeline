{
  "name": "KO Realty · Vacancy turnover",
  "active": false,
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "vacancy/notice", "responseMode": "onReceived" },
      "id": "notice-webhook",
      "name": "Notice logged",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [280, 220]
    },
    {
      "parameters": { "method": "POST", "url": "={{$env.SUPABASE_URL}}/rest/v1/turnover_tasks", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}" }, { "name": "Authorization", "value": "Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}" }, { "name": "Content-Type", "value": "application/json" }] }, "sendBody": true, "jsonBody": "={{ [{ unit_id: $json.unit_id, task_type: 'notice_checklist', status: 'open', tasks: ['Confirm notice dates','Schedule pre-move inspection','Book turnover vendors','Prepare listing copy','Set showing availability'] }] }}" },
      "id": "create-checklist",
      "name": "Create turnover checklist",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 220]
    },
    {
      "parameters": { "method": "POST", "url": "={{$env.LISTING_DRAFT_WEBHOOK_URL}}", "sendBody": true, "jsonBody": "={{ { unit_id: $json.unit_id, prompt: 'Draft a concise rental listing using the unit details. Return headline, description, amenities, and showing CTA.' } }}" },
      "id": "draft-listing",
      "name": "Draft listing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [760, 220]
    },
    {
      "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 24 }] } },
      "id": "daily-check",
      "name": "Daily stuck-unit check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [280, 500]
    },
    {
      "parameters": { "method": "GET", "url": "={{$env.SUPABASE_URL}}/rest/v1/units?select=*&lease_signed_at=is.null&move_out_at=not.is.null&or=(listed_at.is.null,move_out_at.lt.{{$now.minus({days:30}).toISO()}})", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}" }, { "name": "Authorization", "value": "Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}" }] } },
      "id": "find-stuck",
      "name": "Find units past SLA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [520, 500]
    },
    {
      "parameters": { "method": "POST", "url": "={{$env.SLACK_WEBHOOK_URL}}", "sendBody": true, "jsonBody": "={{ { text: '⚠️ Vacancy SLA alert: ' + $json.property_name + ' ' + $json.unit_number + ' needs attention. Open the vacancy pipeline for next steps.' } }}" },
      "id": "alert-team",
      "name": "Alert operations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [760, 500]
    }
  ],
  "connections": {
    "Notice logged": { "main": [[{ "node": "Create turnover checklist", "type": "main", "index": 0 }]] },
    "Create turnover checklist": { "main": [[{ "node": "Draft listing", "type": "main", "index": 0 }]] },
    "Daily stuck-unit check": { "main": [[{ "node": "Find units past SLA", "type": "main", "index": 0 }]] },
    "Find units past SLA": { "main": [[{ "node": "Alert operations", "type": "main", "index": 0 }]] }
  }
}
